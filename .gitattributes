# Generated by tools/assemble-pack.py and tools/publish.py on every build. Two lanes that each rebuilt a book
# will always disagree about these bytes, and a merge conflict here is never a real disagreement: publish
# rebuilds them from the sources afterwards. Keep whichever side is already in the tree and move on.
public/content/packs/** merge=ours
public/content/index.json merge=ours
public/content/build.json merge=ours
public/books/** merge=ours
